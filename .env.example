# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto donde corre la app: http://localhost:3000
PORT=3000

# Clave para firmar las sesiones. Pon cualquier texto largo y aleatorio.
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Administrador que se crea automáticamente la PRIMERA vez que arranca la app.
ADMIN_USER=admin
ADMIN_PASSWORD=Admin2026!
ADMIN_NAME=Administrador

# Zona horaria para decidir "qué día es hoy"
ZONA_HORARIA=America/La_Paz

# (Opcional) Ruta del archivo de base de datos. Por defecto: data/asistencia.db
# DB_PATH=./data/asistencia.db

# (Opcional, solo para pruebas) Simula que hoy es otra fecha, formato AAAA-MM-DD.
# Déjalo comentado en uso real.
# FECHA_PRUEBA=2026-10-05
